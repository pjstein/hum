+    /// Process a candidate clone under the current group's lock. Publish state only on success.
+    /// This pinned provider stages persistence until explicit write_to_storage.
+    /// Hum policy here enforces wire format/AAD shape only, not franking or role policy.
+    pub async fn process_incoming_message_transactional(
+        &self,
+        message: Arc<Message>,
+        hum_policy: bool,
+    ) -> Result<ReceivedMessage, Error> {
+        let mut original = self.inner().await;
+        if hum_policy && message.inner.wire_format() != mls_rs::WireFormat::PrivateMessage {
+            return Err(Error::HumPolicy {
+                reason: "channel requires PrivateMessage".into(),
+            });
+        }
+        let candidate = Group {
+            inner: Arc::new(Mutex::new(original.clone())),
+        };
+        let received = candidate.process_incoming_message(message).await?;
+        if hum_policy {
+            let valid = match &received {
+                ReceivedMessage::ApplicationMessage {
+                    authenticated_data, ..
+                } => authenticated_data.len() == 33 && authenticated_data[0] == 1,
+                ReceivedMessage::Commit {
+                    authenticated_data, ..
+                }
+                | ReceivedMessage::ReceivedProposal {
+                    authenticated_data, ..
+                } => authenticated_data == &[0],
+                _ => false,
+            };
+            if !valid {
+                return Err(Error::HumPolicy {
+                    reason: "authenticated_data shape".into(),
+                });
+            }
+        }
+        *original = candidate.inner().await.clone();
+        Ok(received)
+    }
